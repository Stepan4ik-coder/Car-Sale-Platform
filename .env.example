MODE=LOCAL

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_db_password
DB_NAME=car_sales

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=change_me_to_random_long_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Почта (Mail.ru — пароль приложения, не основной пароль)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=your_email@list.ru
SMTP_PASS=your_app_password
MAIL_FROM=your_email@list.ru
